---
/** Small stroke icons (lucide style), drawn inline so the page loads no icon font. */
const ICONS = {
  tree: '<circle cx="12" cy="4.5" r="2.5"/><circle cx="5.5" cy="19.5" r="2.5"/><circle cx="18.5" cy="19.5" r="2.5"/><path d="M12 7v4.5M12 11.5c-6.5 0-6.5 2.5-6.5 5.5M12 11.5c6.5 0 6.5 2.5 6.5 5.5"/>',
  wallet: '<rect x="3" y="6" width="18" height="14" rx="3"/><path d="M3 10.5h18M16 15h2"/><path d="M6 6l9-3 1.5 3"/>',
  arrows: '<path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/>',
  offline: '<path d="M2 2l20 20"/><path d="M8.5 16.4a5 5 0 0 1 7 0"/><path d="M5 12.8a10 10 0 0 1 5-2.6"/><path d="M19 12.8a10 10 0 0 0-2.6-1.8"/><path d="M2 8.8a15 15 0 0 1 4.2-2.6"/><path d="M22 8.8A15 15 0 0 0 11.2 5"/><path d="M12 20h.01"/>',
  chart: '<path d="M3 3v18h18"/><path d="M8 17v-5M13 17V8M18 17v-8"/>',
  sheet: '<rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M4 9h16M4 15h16M10 3v18"/>',
  cloud: '<path d="M7 18.5a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.6 1.2A3.9 3.9 0 0 1 17.6 18.5z"/><path d="M12 11v5M9.5 13.5 12 11l2.5 2.5"/>',
  scale: '<path d="M12 3v18M7 21h10M5 7h14"/><path d="M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z"/>',
  shield: '<path d="M12 3l8 3v6c0 4.6-3.4 8.1-8 9-4.6-.9-8-4.4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M11 18.5h2"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/>',
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  android: '<path d="M5 10v6a1.5 1.5 0 0 0 1.5 1.5H17.5A1.5 1.5 0 0 0 19 16v-6z"/><path d="M5 9a7 7 0 0 1 14 0z"/><path d="M8 3l1.5 2.5M16 3l-1.5 2.5M9.5 21v-3.5M14.5 21v-3.5"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>
