# Supabase (optional: without these the app works fully offline, only sign-in is off).
# Copy this file to .env.local and fill in the values from the Supabase dashboard:
# Project → Connect (or Settings → API Keys). Both are public; Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
