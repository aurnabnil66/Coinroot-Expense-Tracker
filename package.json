{
  "name": "coinroot",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "bun --cwd apps/mobile start",
    "dev:landing": "bun --cwd apps/landing-page dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:check": "turbo run db:check",
    "check": "turbo run lint typecheck test db:check build",
    "release": "bun run --cwd apps/mobile release",
    "ota": "bun run --cwd apps/mobile ota"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
