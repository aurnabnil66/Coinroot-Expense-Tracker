---
/**
 * The app's Accounts tab drawn in HTML (no screenshot needed): the gradient total card and
 * the account list. Names are the app's generic defaults; amounts are invented.
 */
const accounts = [
  { name: 'Bank Account', type: 'Bank', amount: '৳1,72,800', color: '#6c4cf1' },
  { name: 'Cash', type: 'Cash', amount: '৳5,400', color: '#059669' },
  { name: 'Mobile Wallet', type: 'Mobile wallet', amount: '৳3,100', color: '#e11d48' },
  { name: 'Savings (DPS)', type: 'Savings', amount: '৳64,000', color: '#0284c7' },
];
---

<div class="phone" role="img" aria-label="The Coinroot Accounts screen: total 2,45,300 taka across a bank account, cash, a mobile wallet and a DPS.">
  <div class="screen">
    <div class="status"><span>9:41</span><span class="dots"></span></div>
    <p class="title">Accounts</p>

    <div class="hero">
      <p class="hero-label">Total</p>
      <p class="hero-amount">৳2,45,300</p>
      <div class="tiles">
        <div class="tile"><span>Available</span><strong>৳1,81,300</strong></div>
        <div class="tile"><span>In savings</span><strong>৳64,000</strong></div>
      </div>
    </div>

    <ul class="list">
      {
        accounts.map((a) => (
          <li>
            <span class="badge" style={`--c:${a.color}`}>{a.name.charAt(0)}</span>
            <span class="name">
              {a.name}
              <small>{a.type}</small>
            </span>
            <span class="amount">{a.amount}</span>
          </li>
        ))
      }
    </ul>

    <div class="tabbar">
      <span></span><span class="active">Accounts</span><span></span><span></span>
    </div>
  </div>
</div>

<style>
  .phone {
    width: min(300px, 100%);
    aspect-ratio: 9 / 19;
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(160deg, #2b3566, #0b1026);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.12),
      0 50px 90px -40px rgb(30 42 94 / 0.7);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    padding: 14px 14px 0;
    border-radius: 37px;
    background: #f5f6fc;
    color: #11183b;
    font-size: 12px;
  }

  .status {
    display: flex;
    justify-content: space-between;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 600;
  }
  .dots {
    width: 38px;
    height: 10px;
    border-radius: 6px;
    background: #11183b;
    opacity: 0.8;
  }

  .title {
    margin: 14px 4px 10px;
    font-size: 20px;
    font-weight: 600;
  }

  .hero {
    padding: 14px;
    border-radius: 18px;
    color: #fff;
    background: linear-gradient(135deg, #1e2a5e, #6c4cf1);
  }
  .hero-label {
    opacity: 0.75;
    font-size: 11px;
  }
  .hero-amount {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
  }
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }
  .tile {
    display: grid;
    padding: 8px 10px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.14);
  }
  .tile span {
    opacity: 0.75;
    font-size: 10px;
  }
  .tile strong {
    font-size: 13px;
    font-weight: 600;
  }

  .list {
    margin: 12px 0 0;
    padding: 4px 12px;
    list-style: none;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 20px -12px rgb(30 42 94 / 0.25);
  }
  .list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
  }
  .list li + li {
    border-top: 1px solid #eceefa;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 10px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
    font-weight: 600;
  }
  .name {
    display: grid;
    flex: 1;
    font-weight: 500;
    line-height: 1.3;
  }
  .name small {
    color: #666e91;
    font-size: 10px;
    font-weight: 400;
  }
  .amount {
    font-weight: 600;
  }

  .tabbar {
    position: absolute;
    left: 50%;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    transform: translateX(-50%);
    border: 1px solid #e2e5f2;
    border-radius: 999px;
    background: #fff;
  }
  .tabbar span {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #eceefa;
  }
  .tabbar .active {
    width: auto;
    padding: 0 12px;
    color: #6c4cf1;
    background: rgb(108 76 241 / 0.15);
    font-size: 11px;
    font-weight: 600;
    line-height: 30px;
  }
</style>
